{
  "name": "pi-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "pi-security-brace-expansion": "npm:brace-expansion@5.0.9",
    "pi-security-protobufjs": "npm:protobufjs@7.6.5",
    "pi-security-undici": "npm:undici@8.10.0",
    "platform-security-find-my-way": "npm:find-my-way@9.7.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "postinstall": "node scripts/harden-pi-dependencies.mjs",
    "dependencies:harden": "node scripts/harden-pi-dependencies.mjs",
    "dependencies:check": "node scripts/harden-pi-dependencies.mjs --check",
    "ci": "npm run dependencies:harden && npm run format:check && npm run production:install:check && npm run runtime-policy:check && npm run helm:check && npm run image:closure-check && npm run build && npm run check && npm run backup:crypto-check && npm run security:audit",
    "build": "npm run build --workspaces --if-present",
    "cubesandbox:template-check": "node scripts/run-cubesandbox-template-check.mjs",
    "cubesandbox:live-check": "node scripts/run-cubesandbox-provider-live-check.mjs",
    "cubesandbox:init": "node scripts/init-cubesandbox-runtime.mjs",
    "cubesandbox:images": "node scripts/prefetch-cubesandbox-images.mjs",
    "cubesandbox:cluster-install": "node scripts/install-cubesandbox-k3s.mjs",
    "cubesandbox:template-register": "node scripts/register-cubesandbox-tool-template.mjs",
    "cubesandbox:config": "node scripts/production-compose.mjs config --quiet",
    "cubesandbox:build": "node scripts/production-compose.mjs build",
    "cubesandbox:up": "node scripts/production-compose.mjs up --detach --wait --remove-orphans",
    "cubesandbox:ps": "node scripts/production-compose.mjs ps",
    "cubesandbox:logs": "node scripts/production-compose.mjs logs --follow",
    "cubesandbox:down": "node scripts/production-compose.mjs down",
    "helm:check": "node scripts/check-helm-pi-worker-pool.mjs && node scripts/check-helm-platform.mjs && node scripts/check-enterprise-kafka.mjs",
    "image:closure-check": "node scripts/check-supervisor-image-closure.mjs",
    "kubernetes:pi-workers:install-runtime": "node scripts/ensure-k3d.mjs",
    "kubernetes:pi-workers:up": "node scripts/local-kubernetes-pi-workers.mjs up",
    "kubernetes:pi-workers:down": "node scripts/local-kubernetes-pi-workers.mjs down",
    "kubernetes:pi-workers:status": "node scripts/local-kubernetes-pi-workers.mjs status",
    "kubernetes:pi-workers:check": "node scripts/local-kubernetes-pi-workers.mjs check",
    "kubernetes:distributed:render": "node scripts/distributed-kubernetes.mjs render",
    "kubernetes:distributed:preflight": "node scripts/distributed-kubernetes.mjs preflight",
    "kubernetes:distributed:deploy": "node scripts/distributed-kubernetes.mjs deploy",
    "kubernetes:distributed:status": "node scripts/distributed-kubernetes.mjs status",
    "runtime-policy:check": "node scripts/check-runtime-time-budgets.mjs && node scripts/check-cubesandbox-template-retention.mjs",
    "benchmark:event-spool": "node --experimental-strip-types scripts/run-event-spool-benchmark.mjs",
    "benchmark:postgres-event-log": "tsx scripts/run-postgres-event-log-benchmark.ts",
    "eval:kafka-events": "tsx scripts/run-kafka-event-log-acceptance.ts",
    "eval:enterprise-events": "tsx --tsconfig packages/control-plane/tsconfig.json scripts/run-enterprise-event-pipeline-acceptance.ts",
    "events:rebuild-live": "npm run rebuild-live-events --workspace @pi-cloud/event-gateway",
    "production:init": "node scripts/init-production.mjs",
    "production:config": "node scripts/production-compose.mjs config --quiet",
    "production:config:observability": "PI_CLOUD_PRODUCTION_PROFILES=observability node scripts/production-compose.mjs config --quiet",
    "production:config:github": "PI_CLOUD_PRODUCTION_PROFILES=github node scripts/production-compose.mjs config --quiet",
    "production:build": "node scripts/production-compose.mjs build",
    "production:up": "node scripts/production-compose.mjs up --detach --wait --remove-orphans",
    "production:up:observability": "PI_CLOUD_PRODUCTION_PROFILES=observability node scripts/production-compose.mjs up --detach --wait --remove-orphans",
    "production:up:github": "PI_CLOUD_PRODUCTION_PROFILES=github node scripts/production-compose.mjs up --detach --wait --remove-orphans",
    "production:deploy": "node scripts/run-production-deploy.mjs",
    "production:install:check": "node scripts/test-self-hosted-install.mjs && bash -n install.sh scripts/install-self-hosted.sh",
    "production:ps": "node scripts/production-compose.mjs ps",
    "production:logs": "node scripts/production-compose.mjs logs --follow",
    "production:down": "node scripts/production-compose.mjs down",
    "production:token": "node scripts/print-production-token.mjs",
    "production:tenant": "node scripts/production-compose.mjs run --rm --no-deps database-bootstrap /app/packages/control-plane/src/tenant-admin.ts",
    "production:check": "node scripts/run-live-cubesandbox-production-check.mjs",
    "production:semantic-check": "node scripts/run-live-cubesandbox-production-check.mjs",
    "production:worker-pool-check": "node scripts/run-live-pi-worker-pool-check.mjs",
    "production:control-plane-restart-check": "node scripts/run-live-control-plane-restart-check.mjs",
    "production:multi-tenant-model-load": "node scripts/run-live-multi-tenant-model-load.mjs",
    "production:long-context-check": "node scripts/run-live-long-context-compaction-check.mjs",
    "production:backup": "node scripts/production-backup.mjs",
    "production:restore": "node scripts/production-restore.mjs",
    "backup:crypto-check": "node scripts/run-backup-crypto-check.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "fake-model:start": "npm run start --workspace @pi-cloud/fake-model-server",
    "db:migrate": "npm run migrate --workspace @pi-cloud/database",
    "db:migrate:down": "npm run migrate:down --workspace @pi-cloud/database",
    "demo": "npm run production:deploy",
    "check": "npm run typecheck && npm test",
    "security:audit": "node scripts/run-security-audit.mjs",
    "eval:coding": "node scripts/run-coding-eval.mjs",
    "eval:faults": "node scripts/run-fault-eval.mjs",
    "eval:load": "node scripts/run-control-plane-load.mjs"
  },
  "devDependencies": {
    "@confluentinc/kafka-javascript": "1.10.0",
    "@types/node": "24.12.4",
    "kysely": "0.29.4",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
