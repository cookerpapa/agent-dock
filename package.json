{
  "name": "agent-dock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "ci": "npm run format:check && npm run build && npm run check && npm run security:audit",
    "build": "npm run build --workspaces --if-present",
    "container:config": "docker compose config --quiet",
    "container:check": "node scripts/run-container-check.mjs",
    "sandbox:check": "node scripts/run-docker-sandbox-check.mjs",
    "object-store:check": "node scripts/run-minio-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "spike:pi": "npm run spike --workspace @agent-dock/pi-extension-compat-spike",
    "spike:embedded": "npm run spike --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "spike:density": "npm run density --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "spike:live-model": "npm run live-model --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "fake-model:start": "npm run start --workspace @agent-dock/fake-model-server",
    "db:migrate": "npm run migrate --workspace @agent-dock/database",
    "db:migrate:down": "npm run migrate:down --workspace @agent-dock/database",
    "demo": "node scripts/run-local-demo.mjs",
    "check": "npm run typecheck && npm test && npm run spike:pi && npm run spike:embedded",
    "security:audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
