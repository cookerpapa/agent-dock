{
  "name": "agent-dock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "spikes/*"
  ],
  "dependencies": {
    "pi-security-brace-expansion": "npm:brace-expansion@5.0.7",
    "pi-security-protobufjs": "npm:protobufjs@7.6.5"
  },
  "scripts": {
    "postinstall": "node scripts/harden-pi-dependencies.mjs",
    "dependencies:harden": "node scripts/harden-pi-dependencies.mjs",
    "dependencies:check": "node scripts/harden-pi-dependencies.mjs --check",
    "ci": "npm run dependencies:harden && npm run format:check && npm run helm:check && npm run image:closure-check && npm run build && npm run check && npm run backup:crypto-check && npm run security:audit",
    "build": "npm run build --workspaces --if-present",
    "container:config": "docker compose config --quiet",
    "container:check": "node scripts/run-container-check.mjs",
    "sandbox:check": "node scripts/run-kubernetes-gvisor-sandbox-check.mjs",
    "cubesandbox:template-check": "node scripts/run-cubesandbox-template-check.mjs",
    "cubesandbox:live-check": "AGENT_DOCK_CUBESANDBOX_TEST=1 npm run test --workspace @agent-dock/sandbox-manager -- cubesandbox-live-provider.integration.test.ts",
    "cubesandbox:init": "node scripts/init-cubesandbox-runtime.mjs",
    "cubesandbox:images": "node scripts/prefetch-cubesandbox-images.mjs",
    "cubesandbox:cluster-install": "node scripts/install-cubesandbox-k3s.mjs",
    "cubesandbox:config": "node scripts/cubesandbox-compose.mjs config --quiet",
    "cubesandbox:build": "node scripts/cubesandbox-compose.mjs build",
    "cubesandbox:up": "node scripts/cubesandbox-compose.mjs up --detach --wait --remove-orphans",
    "cubesandbox:ps": "node scripts/cubesandbox-compose.mjs ps",
    "cubesandbox:logs": "node scripts/cubesandbox-compose.mjs logs --follow",
    "cubesandbox:down": "node scripts/cubesandbox-compose.mjs down",
    "helm:check": "node scripts/check-helm-execution-plane.mjs",
    "image:closure-check": "node scripts/check-supervisor-image-closure.mjs",
    "kubernetes:image-sync": "node scripts/sync-kubernetes-tool-image.mjs",
    "object-store:check": "node scripts/run-minio-check.mjs",
    "production:init": "node scripts/init-production.mjs",
    "production:config": "node scripts/production-compose.mjs config --quiet",
    "production:build": "node scripts/production-compose.mjs build",
    "production:up": "node scripts/production-compose.mjs up --detach --wait --remove-orphans",
    "production:deploy": "node scripts/run-production-deploy.mjs",
    "production:ps": "node scripts/production-compose.mjs ps",
    "production:logs": "node scripts/production-compose.mjs logs --follow",
    "production:down": "node scripts/production-compose.mjs down",
    "production:token": "node scripts/print-production-token.mjs",
    "production:tenant": "node scripts/production-compose.mjs run --rm --no-deps database-bootstrap /app/packages/control-plane/src/tenant-admin.ts",
    "production:check": "node scripts/run-production-check.mjs",
    "production:github-check": "node scripts/run-live-github-workspace-check.mjs",
    "production:semantic-check": "node scripts/run-live-semantic-conversation-check.mjs",
    "production:parallel-check": "node scripts/run-live-candidate-race-check.mjs",
    "production:backup": "node scripts/production-backup.mjs",
    "production:restore": "node scripts/production-restore.mjs",
    "backup:crypto-check": "node scripts/run-backup-crypto-check.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "spike:pi": "npm run spike --workspace @agent-dock/pi-extension-compat-spike",
    "spike:embedded": "npm run spike --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "spike:density": "npm run density --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "spike:live-model": "npm run live-model --workspace @agent-dock/pi-embedded-rehydrate-spike",
    "fake-model:start": "npm run start --workspace @agent-dock/fake-model-server",
    "db:migrate": "npm run migrate --workspace @agent-dock/database",
    "db:migrate:down": "npm run migrate:down --workspace @agent-dock/database",
    "demo": "npm run production:deploy",
    "check": "npm run typecheck && npm test && npm run spike:pi && npm run spike:embedded",
    "security:audit": "node scripts/run-security-audit.mjs",
    "eval:coding": "node scripts/run-coding-eval.mjs",
    "eval:faults": "node scripts/run-fault-eval.mjs",
    "eval:load": "node scripts/run-control-plane-load.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
