{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Active runs",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(pi_cloud_active_runs)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Queued runs",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "max(pi_cloud_queued_runs)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Run success (1h)",
      "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(pi_cloud_runs_total{outcome=\"completed\"}[1h])) / clamp_min(sum(increase(pi_cloud_runs_total[1h])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model cost (24h)",
      "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 6 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase(pi_cloud_model_cost_microusd_total[24h])) / 1000000",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run throughput by outcome",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(pi_cloud_runs_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue and Run p95",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pi_cloud_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "queue p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pi_cloud_run_duration_seconds_bucket[5m])))",
          "legendFormat": "run p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model latency p95",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(pi_cloud_model_request_seconds_bucket[5m])))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sandbox lifecycle p95",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(pi_cloud_sandbox_operation_seconds_bucket[5m])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model tokens",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (kind, model) (rate(pi_cloud_model_tokens_total[5m]))",
          "legendFormat": "{{model}} {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool failures",
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "targets": [
        {
          "expr": "sum by (tool) (rate(pi_cloud_tool_duration_seconds_count{outcome=\"failed\"}[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Assigned / session-warm sandboxes",
      "id": 11,
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 29 },
      "targets": [
        {
          "expr": "sum(pi_cloud_sandbox_active{provider=\"cubesandbox\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Never-used clean prewarm sandboxes",
      "id": 12,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 29 },
      "targets": [
        {
          "expr": "sum(pi_cloud_sandbox_prewarm{provider=\"cubesandbox\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Volume Gateway active / limit",
      "id": 13,
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 34 },
      "targets": [
        {
          "expr": "sum(pi_cloud_workspace_volume_gateway_active)",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(pi_cloud_workspace_volume_gateway_limit)",
          "legendFormat": "limit",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Volume Gateway waiting",
      "id": 14,
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 34 },
      "targets": [
        {
          "expr": "sum(pi_cloud_workspace_volume_gateway_waiting)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Capacity rejection rate",
      "id": 15,
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 34 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(pi_cloud_sandbox_admission_rejected_total[5m]))",
          "legendFormat": "Sandbox {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(pi_cloud_workspace_volume_gateway_rejected_total[5m]))",
          "legendFormat": "Volume Gateway {{reason}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Volume Gateway p95",
      "id": 16,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(pi_cloud_workspace_volume_gateway_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} queue",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(pi_cloud_workspace_volume_gateway_operation_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} execution",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["pi-cloud", "coding-agent"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
