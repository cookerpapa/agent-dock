{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workerPool",
    "autoscaling",
    "lifecycle",
    "management",
    "image",
    "services",
    "temporal",
    "conversationStorage",
    "credentials",
    "runtime",
    "state",
    "resources",
    "ephemeral",
    "networkPolicy",
    "disruptionBudget",
    "placement",
    "serviceAccount"
  ],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "workerPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "replicas", "capacity", "executionCellId", "clusterDomain"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "replicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 16 },
        "executionCellId": {
          "type": "string",
          "pattern": "^cell-[a-z0-9](?:[a-z0-9-]{0,54}[a-z0-9])?$"
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "pollingIntervalSeconds",
        "cooldownSeconds",
        "targetQueueSize",
        "scaleDownStabilizationSeconds",
        "scaleDownPeriodSeconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "maxReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "pollingIntervalSeconds": { "type": "integer", "minimum": 2, "maximum": 300 },
        "cooldownSeconds": { "type": "integer", "minimum": 60, "maximum": 7200 },
        "targetQueueSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 7200
        },
        "scaleDownPeriodSeconds": { "type": "integer", "minimum": 60, "maximum": 1800 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminationGracePeriodSeconds"],
      "properties": {
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 960,
          "maximum": 3600
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress"],
      "properties": {
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "hostSuffix", "scheme"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
            },
            "hostSuffix": {
              "type": "string",
              "minLength": 3,
              "maxLength": 190,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"
            },
            "scheme": {
              "type": "string",
              "enum": ["http", "https"]
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._:/-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlaneUrl",
        "sandboxManagerUrls",
        "githubGateway",
        "providerProxyUrl",
        "otlpTracesEndpoint"
      ],
      "properties": {
        "controlPlaneUrl": { "$ref": "#/$defs/httpUrl" },
        "sandboxManagerUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpUrl" }
        },
        "providerProxyUrl": { "$ref": "#/$defs/optionalHttpUrl" },
        "otlpTracesEndpoint": { "$ref": "#/$defs/optionalHttpUrl" },
        "githubGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "url"],
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "$ref": "#/$defs/httpUrl" }
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "namespace", "taskQueue", "workerDeploymentName", "workerBuildId"],
      "properties": {
        "address": { "$ref": "#/$defs/boundedText" },
        "namespace": { "$ref": "#/$defs/boundedText" },
        "taskQueue": { "$ref": "#/$defs/boundedText" },
        "workerDeploymentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "workerBuildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
        }
      }
    },
    "conversationStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "databaseUrlKey", "awsCredentialsKey", "s3"],
      "properties": {
        "existingSecret": { "$ref": "#/$defs/dnsLabel" },
        "databaseUrlKey": { "$ref": "#/$defs/secretKey" },
        "awsCredentialsKey": { "$ref": "#/$defs/secretKey" },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bucket",
            "region",
            "endpoint",
            "keyPrefix",
            "forcePathStyle",
            "allowInsecureEndpoint",
            "maxAttempts"
          ],
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 3,
              "maxLength": 63,
              "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
            },
            "region": { "$ref": "#/$defs/boundedText" },
            "endpoint": { "$ref": "#/$defs/httpUrl" },
            "keyPrefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            "forcePathStyle": { "type": "boolean" },
            "allowInsecureEndpoint": { "type": "boolean" },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisorEnrollmentTokenKey",
        "supervisorManagementTokenKey",
        "sandboxManagerTokenKey",
        "modelCredentialMasterKeyKey",
        "githubGatewayTokenKey",
        "metricsTokenKey"
      ],
      "properties": {
        "supervisorEnrollmentTokenKey": { "$ref": "#/$defs/secretKey" },
        "supervisorManagementTokenKey": { "$ref": "#/$defs/secretKey" },
        "sandboxManagerTokenKey": { "$ref": "#/$defs/secretKey" },
        "modelCredentialMasterKeyKey": { "$ref": "#/$defs/secretKey" },
        "githubGatewayTokenKey": { "$ref": "#/$defs/secretKey" },
        "metricsTokenKey": { "$ref": "#/$defs/secretKey" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowInsecureInternalHttp",
        "externalWorkerEventLog",
        "checkpointCache",
        "timeouts",
        "repositoryImport"
      ],
      "properties": {
        "allowInsecureInternalHttp": { "type": "boolean" },
        "externalWorkerEventLog": { "type": "boolean" },
        "checkpointCache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ttlMs", "maximumEntries", "maximumBytes"],
          "properties": {
            "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "maximumEntries": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "maximumBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 536870912
            }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sandboxManagerRequestMs",
            "modelUpstreamRequestMs",
            "modelRequestMs",
            "turnMs"
          ],
          "properties": {
            "sandboxManagerRequestMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 900000
            },
            "modelUpstreamRequestMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "modelRequestMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "turnMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 900000
            }
          }
        },
        "repositoryImport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaseMs", "waitMs"],
          "properties": {
            "leaseMs": { "type": "integer", "minimum": 1000, "maximum": 900000 },
            "waitMs": { "type": "integer", "minimum": 1000, "maximum": 900000 }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClassName", "accessModes", "size"],
      "properties": {
        "storageClassName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOncePod", "ReadWriteOnce"] }
        },
        "size": { "$ref": "#/$defs/quantity" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/$defs/resources" },
        "limits": { "$ref": "#/$defs/resources" }
      }
    },
    "ephemeral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceSizeLimit", "temporarySizeLimit"],
      "properties": {
        "workspaceSizeLimit": { "$ref": "#/$defs/quantity" },
        "temporarySizeLimit": { "$ref": "#/$defs/quantity" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trustedNamespaceLabel", "trustedTcpPorts", "externalEgressCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trustedNamespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9./_-]+$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "trustedTcpPorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "externalEgressCidrs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "disruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minAvailable"],
      "properties": {
        "minAvailable": { "type": "integer", "minimum": 1, "maximum": 63 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeSelector", "tolerations"],
      "properties": {
        "nodeSelector": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "maxLength": 256 }
        },
        "tolerations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "maxLength": 253 },
              "operator": { "type": "string", "enum": ["Equal", "Exists"] },
              "value": { "type": "string", "maxLength": 63 },
              "effect": {
                "type": "string",
                "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]
              },
              "tolerationSeconds": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[ -~]+$"
    },
    "httpUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024,
      "pattern": "^https?://[^\\s]+$"
    },
    "optionalHttpUrl": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^$|^https?://[^\\s]+$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^([1-9][0-9]*m|[1-9][0-9]*)$"
        },
        "memory": { "$ref": "#/$defs/quantity" }
      }
    }
  }
}
