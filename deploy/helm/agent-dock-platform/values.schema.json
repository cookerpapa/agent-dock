{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "piWorkersEnabled",
    "global",
    "images",
    "bootstrap",
    "controlPlane",
    "web",
    "external",
    "networkPolicy",
    "sandboxPlane",
    "pi-workers"
  ],
  "properties": {
    "piWorkersEnabled": { "type": "boolean", "const": true },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterDomain",
        "existingSecret",
        "imagePullSecrets",
        "imageRevision",
        "storageClassName",
        "trustedNodeSelector",
        "trustedTolerations"
      ],
      "properties": {
        "clusterDomain": { "$ref": "#/$defs/dnsName" },
        "existingSecret": { "$ref": "#/$defs/dnsLabel" },
        "imagePullSecrets": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "$ref": "#/$defs/dnsLabel" } }
          }
        },
        "imageRevision": { "$ref": "#/$defs/boundedText" },
        "storageClassName": { "$ref": "#/$defs/optionalDnsName" },
        "trustedNodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "trustedTolerations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "web", "sandboxManager"],
      "properties": {
        "controlPlane": { "$ref": "#/$defs/image" },
        "web": { "$ref": "#/$defs/image" },
        "sandboxManager": { "$ref": "#/$defs/image" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "tenantId",
        "tenantSlug",
        "userId",
        "apiCredentialId",
        "credentialBindingId",
        "defaultModelProfileId",
        "modelProfileName",
        "maximumProjects",
        "maximumSessions",
        "maximumUnsettledTurns",
        "maximumConcurrentTurns"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "tenantId": { "$ref": "#/$defs/uuid" },
        "tenantSlug": { "$ref": "#/$defs/dnsLabel" },
        "userId": { "$ref": "#/$defs/uuid" },
        "apiCredentialId": { "$ref": "#/$defs/uuid" },
        "credentialBindingId": { "$ref": "#/$defs/uuid" },
        "defaultModelProfileId": { "$ref": "#/$defs/uuid" },
        "modelProfileName": { "$ref": "#/$defs/boundedText" },
        "maximumProjects": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumSessions": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumUnsettledTurns": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumConcurrentTurns": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "controlPlane": { "$ref": "#/$defs/httpWorkload" },
    "web": {
      "allOf": [
        { "$ref": "#/$defs/httpWorkload" },
        {
          "type": "object",
          "required": ["ingress"],
          "properties": {
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "className", "host", "tlsSecretName"],
              "properties": {
                "enabled": { "type": "boolean" },
                "className": { "$ref": "#/$defs/optionalDnsName" },
                "host": { "$ref": "#/$defs/dnsName" },
                "tlsSecretName": { "$ref": "#/$defs/optionalDnsName" }
              }
            }
          }
        }
      ]
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "temporal",
        "checkpointS3",
        "kopiaS3",
        "providerProxyUrl",
        "otlpTracesEndpoint"
      ],
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretKey", "notificationSecretKey", "apiTokenSecretKey"],
          "properties": {
            "secretKey": { "$ref": "#/$defs/secretKey" },
            "notificationSecretKey": { "$ref": "#/$defs/secretKey" },
            "apiTokenSecretKey": { "$ref": "#/$defs/secretKey" }
          }
        },
        "temporal": { "$ref": "#/$defs/temporal" },
        "checkpointS3": { "$ref": "#/$defs/s3" },
        "kopiaS3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "region", "bucket", "prefix", "disableTls"],
          "properties": {
            "endpoint": { "$ref": "#/$defs/boundedText" },
            "region": { "$ref": "#/$defs/boundedText" },
            "bucket": { "$ref": "#/$defs/bucket" },
            "prefix": { "$ref": "#/$defs/path" },
            "disableTls": { "type": "boolean" }
          }
        },
        "providerProxyUrl": { "$ref": "#/$defs/httpUrl" },
        "otlpTracesEndpoint": { "$ref": "#/$defs/optionalHttpUrl" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trustedNamespaceLabel", "trustedTcpPorts", "externalEgressCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trustedNamespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9./_-]+$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "trustedTcpPorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "externalEgressCidrs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": { "const": "0.0.0.0/0" },
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "sandboxPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "executionCellId",
        "maximumActivePerReplica",
        "maximumWarmPerReplica",
        "warmTtlMs",
        "workspace",
        "state",
        "cube",
        "managerResources",
        "dataMoverResources"
      ],
      "properties": {
        "replicas": { "type": "integer", "minimum": 3, "maximum": 64 },
        "executionCellId": { "$ref": "#/$defs/boundedText" },
        "maximumActivePerReplica": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maximumWarmPerReplica": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "warmTtlMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingClaim"],
          "properties": { "existingClaim": { "$ref": "#/$defs/dnsLabel" } }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": { "size": { "$ref": "#/$defs/quantity" } }
        },
        "cube": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiUrl",
            "templateId",
            "proxyNodeIp",
            "proxyPort",
            "proxyScheme",
            "domain",
            "egressProxyHost",
            "egressProxyPort"
          ],
          "properties": {
            "apiUrl": { "$ref": "#/$defs/httpUrl" },
            "templateId": { "$ref": "#/$defs/boundedText" },
            "proxyNodeIp": { "$ref": "#/$defs/boundedText" },
            "proxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "proxyScheme": { "type": "string", "enum": ["http", "https"] },
            "domain": { "$ref": "#/$defs/dnsName" },
            "egressProxyHost": { "$ref": "#/$defs/boundedText" },
            "egressProxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "managerResources": { "$ref": "#/$defs/resources" },
        "dataMoverResources": { "$ref": "#/$defs/resources" }
      }
    },
    "pi-workers": { "type": "object" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "optionalDnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 512 },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "httpUrl": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 1024 },
    "optionalHttpUrl": { "type": "string", "pattern": "^$|^https?://[^\\s]+$", "maxLength": 1024 },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._/-]+$" },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
    },
    "quantity": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": { "cpu": {}, "memory": {} }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": { "cpu": {}, "memory": {} }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCpuUtilization"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "maxReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "targetCpuUtilization": { "type": "integer", "minimum": 10, "maximum": 95 }
      }
    },
    "httpWorkload": {
      "type": "object",
      "required": ["replicas", "autoscaling", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "autoscaling": { "$ref": "#/$defs/autoscaling" },
        "resources": { "$ref": "#/$defs/resources" },
        "platformModelSourceTenantId": { "$ref": "#/$defs/uuid" },
        "platformOperatorTenantId": { "$ref": "#/$defs/uuid" },
        "publicRegistrationEnabled": { "type": "boolean" },
        "supervisorIdPrefix": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "namespace", "taskQueue"],
      "properties": {
        "address": { "$ref": "#/$defs/boundedText" },
        "namespace": { "$ref": "#/$defs/boundedText" },
        "taskQueue": { "$ref": "#/$defs/boundedText" }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "region",
        "bucket",
        "keyPrefix",
        "forcePathStyle",
        "allowInsecureEndpoint"
      ],
      "properties": {
        "endpoint": { "$ref": "#/$defs/httpUrl" },
        "region": { "$ref": "#/$defs/boundedText" },
        "bucket": { "$ref": "#/$defs/bucket" },
        "keyPrefix": { "$ref": "#/$defs/path" },
        "forcePathStyle": { "type": "boolean" },
        "allowInsecureEndpoint": { "type": "boolean" }
      }
    }
  }
}
