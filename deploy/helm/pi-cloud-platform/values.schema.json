{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "piWorkersEnabled",
    "sandboxPlaneEnabled",
    "globalPlaneEnabled",
    "sandboxDomains",
    "global",
    "images",
    "bootstrap",
    "controlPlane",
    "eventRetention",
    "eventGateway",
    "web",
    "external",
    "networkPolicy",
    "sandboxPlane",
    "pi-workers"
  ],
  "properties": {
    "piWorkersEnabled": { "type": "boolean" },
    "sandboxPlaneEnabled": { "type": "boolean" },
    "globalPlaneEnabled": { "type": "boolean" },
    "sandboxDomains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/sandboxDomain" }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterDomain",
        "existingSecret",
        "imagePullSecrets",
        "imageRevision",
        "storageClassName",
        "trustedNodeSelector",
        "trustedTolerations"
      ],
      "properties": {
        "clusterDomain": { "$ref": "#/$defs/dnsName" },
        "existingSecret": { "$ref": "#/$defs/dnsLabel" },
        "imagePullSecrets": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "$ref": "#/$defs/dnsLabel" } }
          }
        },
        "imageRevision": { "$ref": "#/$defs/boundedText" },
        "storageClassName": { "$ref": "#/$defs/optionalDnsName" },
        "trustedNodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "trustedTolerations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "eventGateway", "web", "toolBroker"],
      "properties": {
        "controlPlane": { "$ref": "#/$defs/image" },
        "eventGateway": { "$ref": "#/$defs/image" },
        "web": { "$ref": "#/$defs/image" },
        "toolBroker": { "$ref": "#/$defs/image" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "tenantId",
        "tenantSlug",
        "userId",
        "apiCredentialId",
        "credentialBindingId",
        "defaultModelProfileId",
        "modelProfileName",
        "maximumProjects",
        "maximumSessions",
        "maximumUnsettledTurns",
        "maximumConcurrentTurns",
        "maximumActiveSandboxes"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "tenantId": { "$ref": "#/$defs/uuid" },
        "tenantSlug": { "$ref": "#/$defs/dnsLabel" },
        "userId": { "$ref": "#/$defs/uuid" },
        "apiCredentialId": { "$ref": "#/$defs/uuid" },
        "credentialBindingId": { "$ref": "#/$defs/uuid" },
        "defaultModelProfileId": { "$ref": "#/$defs/uuid" },
        "modelProfileName": { "$ref": "#/$defs/boundedText" },
        "maximumProjects": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumSessions": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumUnsettledTurns": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumConcurrentTurns": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maximumActiveSandboxes": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "controlPlane": { "$ref": "#/$defs/httpWorkload" },
    "eventRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "intervalMs", "batchSize", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 32 },
        "intervalMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "eventGateway": { "$ref": "#/$defs/httpWorkload" },
    "web": {
      "allOf": [
        { "$ref": "#/$defs/httpWorkload" },
        {
          "type": "object",
          "required": ["ingress"],
          "properties": {
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "className", "host", "tlsSecretName"],
              "properties": {
                "enabled": { "type": "boolean" },
                "className": { "$ref": "#/$defs/optionalDnsName" },
                "host": { "$ref": "#/$defs/dnsName" },
                "tlsSecretName": { "$ref": "#/$defs/optionalDnsName" }
              }
            }
          }
        }
      ]
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventIngest",
        "database",
        "kafka",
        "liveEventStore",
        "providerProxyUrl",
        "otlpTracesEndpoint"
      ],
      "properties": {
        "eventIngest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceUrl", "tokenSecretKey"],
          "properties": {
            "serviceUrl": { "$ref": "#/$defs/httpUrl" },
            "tokenSecretKey": { "$ref": "#/$defs/secretKey" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretKey", "notificationSecretKey", "apiTokenSecretKey"],
          "properties": {
            "secretKey": { "$ref": "#/$defs/secretKey" },
            "notificationSecretKey": { "$ref": "#/$defs/secretKey" },
            "apiTokenSecretKey": { "$ref": "#/$defs/secretKey" }
          }
        },
        "kafka": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brokers", "topic", "projectorGroupId", "security"],
          "properties": {
            "brokers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/boundedText" }
            },
            "topic": { "$ref": "#/$defs/boundedText" },
            "projectorGroupId": { "$ref": "#/$defs/boundedText" },
            "security": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "caSecretKey", "usernameSecretKey", "passwordSecretKey"],
              "properties": {
                "enabled": { "type": "boolean" },
                "caSecretKey": { "$ref": "#/$defs/secretKey" },
                "usernameSecretKey": { "$ref": "#/$defs/secretKey" },
                "passwordSecretKey": { "$ref": "#/$defs/secretKey" }
              }
            }
          }
        },
        "liveEventStore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["urlSecretKey"],
          "properties": { "urlSecretKey": { "$ref": "#/$defs/secretKey" } }
        },
        "providerProxyUrl": { "$ref": "#/$defs/httpUrl" },
        "otlpTracesEndpoint": { "$ref": "#/$defs/optionalHttpUrl" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trustedNamespaceLabel", "trustedTcpPorts", "externalEgressCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trustedNamespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9./_-]+$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "trustedTcpPorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "externalEgressCidrs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": { "const": "0.0.0.0/0" },
            "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "sandboxPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "toolBrokerReplicas",
        "volumeGatewayReplicas",
        "volumeGatewayMaximumConcurrentOperations",
        "volumeGatewayMaximumQueuedOperations",
        "volumeGatewayQueueWaitTimeoutMs",
        "workspaceDeletionReaperIntervalMs",
        "workspaceDeletionReaperBatchSize",
        "volumeGatewayRequestTimeoutMs",
        "maximumActivePerReplica",
        "maximumWarmPerReplica",
        "warmTtlMs",
        "workspace",
        "state",
        "cube",
        "toolBrokerResources",
        "volumeGatewayResources"
      ],
      "properties": {
        "domainId": { "$ref": "#/$defs/boundedText" },
        "toolBrokerReplicas": { "type": "integer", "minimum": 3, "maximum": 64 },
        "volumeGatewayReplicas": { "type": "integer", "minimum": 1, "maximum": 64 },
        "volumeGatewayMaximumConcurrentOperations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "volumeGatewayMaximumQueuedOperations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "volumeGatewayQueueWaitTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "workspaceDeletionReaperIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "workspaceDeletionReaperBatchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "volumeGatewayRequestTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "maximumActivePerReplica": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maximumWarmPerReplica": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "warmTtlMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingClaim"],
          "properties": { "existingClaim": { "$ref": "#/$defs/dnsLabel" } }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": { "size": { "$ref": "#/$defs/quantity" } }
        },
        "cube": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiUrl",
            "templateId",
            "proxyNodeIp",
            "proxyPort",
            "proxyScheme",
            "domain",
            "egressProxyHost",
            "egressProxyPort"
          ],
          "properties": {
            "apiUrl": { "$ref": "#/$defs/httpUrl" },
            "templateId": { "$ref": "#/$defs/boundedText" },
            "proxyNodeIp": { "$ref": "#/$defs/boundedText" },
            "proxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "proxyScheme": { "type": "string", "enum": ["http", "https"] },
            "domain": { "$ref": "#/$defs/dnsName" },
            "egressProxyHost": { "$ref": "#/$defs/boundedText" },
            "egressProxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "toolBrokerResources": { "$ref": "#/$defs/resources" },
        "volumeGatewayResources": { "$ref": "#/$defs/resources" }
      }
    },
    "pi-workers": { "type": "object" }
  },
  "$defs": {
    "sandboxDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "state",
        "toolBrokerBaseUrl",
        "workspaceStorageKey",
        "maximumActiveSandboxes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sandbox-domain-[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "type": "string", "enum": ["active", "draining", "disabled"] },
        "toolBrokerBaseUrl": { "$ref": "#/$defs/httpUrl" },
        "workspaceStorageKey": { "$ref": "#/$defs/path" },
        "maximumActiveSandboxes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "dnsName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "optionalDnsName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 512 },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "httpUrl": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 1024 },
    "optionalHttpUrl": { "type": "string", "pattern": "^$|^https?://[^\\s]+$", "maxLength": 1024 },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._/-]+$" },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
    },
    "quantity": { "type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": { "cpu": {}, "memory": {} }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": { "cpu": {}, "memory": {} }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCpuUtilization"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "maxReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "targetCpuUtilization": { "type": "integer", "minimum": 10, "maximum": 95 },
        "pollingIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "cooldownSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "kafkaLagThreshold": { "type": "string", "pattern": "^[1-9][0-9]{0,8}$" }
      }
    },
    "httpWorkload": {
      "type": "object",
      "required": ["replicas", "autoscaling", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "autoscaling": { "$ref": "#/$defs/autoscaling" },
        "resources": { "$ref": "#/$defs/resources" },
        "platformModelSourceTenantId": { "$ref": "#/$defs/uuid" },
        "platformOperatorTenantId": { "$ref": "#/$defs/uuid" },
        "publicRegistration": { "$ref": "#/$defs/publicRegistration" },
        "supervisorIdPrefix": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    },
    "publicRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maximumTenants",
        "maximumProjects",
        "maximumSessions",
        "maximumUnsettledTurns",
        "maximumConcurrentTurns",
        "maximumActiveSandboxes"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "maximumTenants": { "type": "integer", "minimum": 2, "maximum": 1000000 },
        "maximumProjects": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumSessions": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumUnsettledTurns": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumConcurrentTurns": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maximumActiveSandboxes": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "unused": { "type": "null" }
  }
}
