{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "workerPool",
    "autoscaling",
    "lifecycle",
    "management",
    "image",
    "services",
    "database",
    "credentials",
    "runtime",
    "state",
    "resources",
    "ephemeral",
    "networkPolicy",
    "disruptionBudget",
    "placement",
    "serviceAccount"
  ],
  "properties": {
    "global": { "type": "object", "additionalProperties": true },
    "workerPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "replicas", "capacity", "clusterDomain"],
      "properties": {
        "name": { "$ref": "#/$defs/dnsLabel" },
        "replicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 64 },
        "clusterDomain": { "$ref": "#/$defs/domain" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "pollingIntervalSeconds",
        "cooldownSeconds",
        "targetQueuedRunsPerReplica",
        "scaleDownStabilizationSeconds",
        "scaleDownPeriodSeconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "maxReplicas": { "type": "integer", "minimum": 2, "maximum": 256 },
        "pollingIntervalSeconds": { "type": "integer", "minimum": 2, "maximum": 300 },
        "cooldownSeconds": { "type": "integer", "minimum": 60, "maximum": 7200 },
        "targetQueuedRunsPerReplica": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "scaleDownStabilizationSeconds": { "type": "integer", "minimum": 300, "maximum": 7200 },
        "scaleDownPeriodSeconds": { "type": "integer", "minimum": 60, "maximum": 1800 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminationGracePeriodSeconds"],
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 960, "maximum": 3600 }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress"],
      "properties": {
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "hostSuffix", "scheme"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string", "maxLength": 63 },
            "hostSuffix": { "$ref": "#/$defs/domain" },
            "scheme": { "enum": ["http", "https"] }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "tag": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlaneUrl",
        "eventGatewayUrl",
        "toolBrokerUrls",
        "githubGateway",
        "providerProxyUrl",
        "otlpTracesEndpoint"
      ],
      "properties": {
        "controlPlaneUrl": { "$ref": "#/$defs/httpUrl" },
        "eventGatewayUrl": { "$ref": "#/$defs/httpUrl" },
        "toolBrokerUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/httpUrl" }
        },
        "providerProxyUrl": { "$ref": "#/$defs/optionalHttpUrl" },
        "otlpTracesEndpoint": { "$ref": "#/$defs/optionalHttpUrl" },
        "githubGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "url"],
          "properties": { "enabled": { "type": "boolean" }, "url": { "$ref": "#/$defs/httpUrl" } }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "urlKey", "notificationUrlKey"],
      "properties": {
        "existingSecret": { "$ref": "#/$defs/dnsLabel" },
        "urlKey": { "$ref": "#/$defs/secretKey" },
        "notificationUrlKey": { "$ref": "#/$defs/secretKey" }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisorEnrollmentTokenKey",
        "supervisorManagementTokenKey",
        "toolBrokerTokenKey",
        "modelCredentialMasterKeyKey",
        "githubGatewayTokenKey",
        "metricsTokenKey",
        "workerEventIngestTokenKey"
      ],
      "properties": {
        "supervisorEnrollmentTokenKey": { "$ref": "#/$defs/secretKey" },
        "supervisorManagementTokenKey": { "$ref": "#/$defs/secretKey" },
        "toolBrokerTokenKey": { "$ref": "#/$defs/secretKey" },
        "modelCredentialMasterKeyKey": { "$ref": "#/$defs/secretKey" },
        "githubGatewayTokenKey": { "$ref": "#/$defs/secretKey" },
        "metricsTokenKey": { "$ref": "#/$defs/secretKey" },
        "workerEventIngestTokenKey": { "$ref": "#/$defs/secretKey" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowInsecureInternalHttp",
        "externalWorkerEventLog",
        "subagents",
        "checkpointCache",
        "timeouts",
        "repositoryImport"
      ],
      "properties": {
        "allowInsecureInternalHttp": { "type": "boolean" },
        "externalWorkerEventLog": { "type": "boolean" },
        "subagents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumDepth", "maximumNodes", "maximumConcurrent"],
          "properties": {
            "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 64 },
            "maximumNodes": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maximumConcurrent": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "checkpointCache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ttlMs", "maximumEntries", "maximumBytes"],
          "properties": {
            "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "maximumEntries": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "maximumBytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 }
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolBrokerRequestMs",
            "modelCapabilityTtlMs",
            "modelUpstreamRequestMs",
            "modelRequestMs",
            "turnMs"
          ],
          "properties": {
            "toolBrokerRequestMs": { "$ref": "#/$defs/positiveMs" },
            "modelCapabilityTtlMs": { "$ref": "#/$defs/positiveMs" },
            "modelUpstreamRequestMs": { "$ref": "#/$defs/positiveMs" },
            "modelRequestMs": { "$ref": "#/$defs/positiveMs" },
            "turnMs": { "$ref": "#/$defs/positiveMs" }
          }
        },
        "repositoryImport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaseMs", "waitMs"],
          "properties": {
            "leaseMs": { "$ref": "#/$defs/positiveMs" },
            "waitMs": { "$ref": "#/$defs/positiveMs" }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClassName", "accessModes", "size"],
      "properties": {
        "storageClassName": { "type": "string", "maxLength": 253 },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod"] }
        },
        "size": { "$ref": "#/$defs/quantity" }
      }
    },
    "resources": { "type": "object" },
    "ephemeral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceSizeLimit", "temporarySizeLimit"],
      "properties": {
        "workspaceSizeLimit": { "$ref": "#/$defs/quantity" },
        "temporarySizeLimit": { "$ref": "#/$defs/quantity" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trustedNamespaceLabel", "trustedTcpPorts", "externalEgressCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "trustedNamespaceLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "trustedTcpPorts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "externalEgressCidrs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
          "uniqueItems": true
        }
      }
    },
    "disruptionBudget": {
      "type": "object",
      "required": ["minAvailable"],
      "properties": { "minAvailable": { "type": "integer", "minimum": 1, "maximum": 255 } }
    },
    "placement": {
      "type": "object",
      "required": ["nodeSelector", "tolerations"],
      "properties": { "nodeSelector": { "type": "object" }, "tolerations": { "type": "array" } }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 63 }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "httpUrl": { "type": "string", "pattern": "^https?://[^[:space:]]+$" },
    "optionalHttpUrl": { "type": "string", "pattern": "^$|^https?://[^[:space:]]+$" },
    "positiveMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
    "quantity": { "type": "string", "pattern": "^[0-9]+(?:Ki|Mi|Gi|Ti)?$" }
  }
}
